# ===================================================
# ZenCraft E-Commerce Payment Gateway Configurations
# ===================================================

# 1. Stripe Payment Gateway (Global Credit Cards, Apple Pay, Google Pay)
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# 2. PayPal Gateway (Pay in 4, PayPal Wallet)
# Get keys from: https://developer.paypal.com/dashboard/applications/
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# 3. Currency and Store Configuration
NEXT_PUBLIC_STORE_CURRENCY=USD
NEXT_PUBLIC_STORE_NAME=ZenCraft Atelier
